# Copy to .env (or enter these in Portainer's stack environment).
# Use letters and digits for DB_PASSWORD: it goes into a connection URL.
DB_PASSWORD=change-me-to-something-long
FAVOR_ADMIN_PASSWORD=change-me-too
# Optional: accounts to create on first start. Afterwards use /admin.
FAVOR_USERS=Marta:change-me,Leo:change-me,Inés:change-me
FAVOR_HOUSE_NAME=Flat 3B
FAVOR_TZ=Europe/Madrid
FAVOR_COOKIE_SECURE=false
FAVOR_PORT=8080
